{
  "manifest_version": 3,
  "name": "Supercrit",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Unofficial Letterboxd integration for the Criterion Channel",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://letterboxd.com/*"
  ],
  "action": {
    "default_title": "Supercrit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.criterionchannel.com/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/letterboxd.js",
        "lib/criterion.js",
        "lib/site.js",
        "lib/snapshot.js",
        "lib/user.js",
        "lib/settings.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
